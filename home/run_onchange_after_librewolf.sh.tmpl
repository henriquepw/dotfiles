#!/usr/bin/env bash
# librewolf profile dirs have random names, so copy the css and user.js into every profile
# userChrome.css hash: {{ include ".librewolf/chrome/userChrome.css" | sha256sum }}
# userContent.css hash: {{ include ".librewolf/chrome/userContent.css" | sha256sum }}
# tangerina-content.css hash: {{ include ".librewolf/chrome/tangerina-content.css" | sha256sum }}
# user.js hash: {{ include ".librewolf/user.js" | sha256sum }}
set -euo pipefail

src="{{ .chezmoi.sourceDir }}/.librewolf"
root="$HOME/.config/librewolf/librewolf"

[ -f "$root/profiles.ini" ] || exit 0

grep -oP '^Path=\K.*' "$root/profiles.ini" | while read -r profile; do
    dir="$root/$profile"
    [ -d "$dir" ] || continue
    mkdir -p "$dir/chrome"
    cp "$src/chrome/userChrome.css" "$src/chrome/userContent.css" "$src/chrome/tangerina-content.css" "$dir/chrome/"
    cp "$src/user.js" "$dir/user.js"
done

{{- $brew := "/home/linuxbrew/.linuxbrew" -}}
{{- $gcc := glob (printf "%s/bin/gcc-[0-9]*" $brew) -}}
{{- $gxx := glob (printf "%s/bin/g++-[0-9]*" $brew) -}}
{{- if and $gcc $gxx }}
CC={{ last $gcc }}
CXX={{ last $gxx }}
{{- end }}
CGO_CXXFLAGS=-I{{ $brew }}/include -I{{ $brew }}/opt/openblas/include
CGO_LDFLAGS=-L{{ $brew }}/lib -L{{ $brew }}/opt/openblas/lib -L{{ .chezmoi.homeDir }}/.local/lib/cblas -Wl,-rpath,{{ $brew }}/lib -Wl,-rpath,{{ $brew }}/opt/openblas/lib

#!/usr/bin/env bash
# librewolf profile dirs have random names, so copy the css into every profile
# userChrome.css hash: {{ include ".librewolf/chrome/userChrome.css" | sha256sum }}
# userContent.css hash: {{ include ".librewolf/chrome/userContent.css" | sha256sum }}
set -euo pipefail

src="{{ .chezmoi.sourceDir }}/.librewolf/chrome"
root="$HOME/.var/app/io.gitlab.librewolf-community/config/librewolf/librewolf"
pref='user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'

[ -f "$root/profiles.ini" ] || exit 0

grep -oP '^Path=\K.*' "$root/profiles.ini" | while read -r profile; do
    dir="$root/$profile"
    [ -d "$dir" ] || continue
    mkdir -p "$dir/chrome"
    cp "$src/userChrome.css" "$src/userContent.css" "$dir/chrome/"
    grep -qxF "$pref" "$dir/user.js" 2>/dev/null || echo "$pref" >> "$dir/user.js"
done

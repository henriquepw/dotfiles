#!/bin/sh
# Wrapper for /usr/sbin/mmsg: fixes stale MANGO_INSTANCE_SIGNATURE
# (e.g. terminals opened before mango was restarted).
if [ ! -S "$MANGO_INSTANCE_SIGNATURE" ]; then
    run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    sig=""
    for pid in $(pgrep -x -u "$(id -u)" mango); do
        [ -S "$run/mango-$pid.sock" ] && sig="$run/mango-$pid.sock"
    done
    [ -n "$sig" ] && export MANGO_INSTANCE_SIGNATURE="$sig"
fi
exec /usr/sbin/mmsg "$@"

#!/usr/bin/env bash
set -euo pipefail

monitor=DP-2
tv=HDMI-A-1
card=alsa_card.pci-0000_09_00.1
tv_profile=output:hdmi-stereo-extra3
state=${XDG_RUNTIME_DIR:-/tmp}/tv-mode-audio

width() {
	mmsg get monitor "$1" | jq -r '.width'
}

card_json() {
	pactl -f json list cards | jq --arg card "$card" '.[] | select(.name == $card)'
}

use_tv_audio() {
	pactl set-card-profile "$card" "$tv_profile"
	pactl set-default-sink "alsa_output.pci-0000_09_00.1.${tv_profile#output:}"
}

restore_audio() {
	[[ -f $state ]] || return 0
	local sink profile
	{
		read -r sink
		read -r profile
	} <"$state"
	pactl set-card-profile "$card" "$profile"
	pactl set-default-sink "$sink"
	rm -f "$state"
}

stop_steam() {
	pgrep -x steam >/dev/null || return 0
	steam -shutdown
	for _ in {1..30}; do
		pgrep -x steam >/dev/null || return 0
		sleep 0.5
	done
	echo "tv-mode: steam não fechou a tempo" >&2
}

start_gamescope_steam() {
	setsid -f gamescope -e -f -W 3840 -H 2160 -r 120 --hdr-enabled --adaptive-sync \
		-- steam -gamepadui steam://open/bigpicture >/dev/null 2>&1
}

if [[ $(width "$monitor") -gt 0 ]]; then
	printf '%s\n%s\n' "$(pactl get-default-sink)" "$(card_json | jq -r '.active_profile')" >"$state"
	stop_steam
	mmsg dispatch "enable_monitor,$tv"
	mmsg dispatch "disable_monitor,$monitor"
	use_tv_audio
	pkill -x zapfast || true
	if flatpak ps --columns=application | grep -qx moe.sable.client; then
		flatpak kill moe.sable.client
	fi
	start_gamescope_steam
else
	stop_steam
	pkill -x gamescope || true
	mmsg dispatch "enable_monitor,$monitor"
	mmsg dispatch "disable_monitor,$tv"
	restore_audio
	setsid -f steam -silent >/dev/null 2>&1
fi
